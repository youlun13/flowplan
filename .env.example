# FlowPlan 環境變數範例 —— 只放變數名稱，絕不填真正的金鑰。
# 第一階段（本地 / 無 AI）不需要任何變數；以下留給第三階段的 AI 代理（伺服器端）使用。

# Anthropic API 金鑰（只放在部署平台的伺服器端環境變數，永遠不進前端 bundle）
ANTHROPIC_API_KEY=

# 代理通關密語：前端要帶這組密語才能呼叫 AI 代理，避免陌生人燒你的額度
FLOWPLAN_PROXY_SECRET=

# 應用層保護：每日 AI 請求上限與單次最大輸出 token（輔助保護，不取代官方 workspace spend limit）
AI_DAILY_LIMIT=30
AI_MAX_OUTPUT_TOKENS=1024
AI_MODEL=claude-haiku-5-5
