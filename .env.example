# FlowPlan 環境變數範例 —— 只放變數名稱，絕不填真正的金鑰。
#
# 前端（GitHub Pages）只有一個「建置時」變數，不是秘密：
#   VITE_FLOWPLAN_PROXY_URL  預設 Worker 網址，設在 .github/workflows/deploy.yml；本機開發可放 .env.local
VITE_FLOWPLAN_PROXY_URL=

# 以下全部屬於 Cloudflare Worker（worker/），設定在 Worker 的 Variables and Secrets，
# 或用 `npx wrangler secret put <NAME>` 寫入。

# Anthropic API 金鑰（Secret）—— 只存在 Worker，永遠不進前端 bundle
ANTHROPIC_API_KEY=

# 單人模式通關密語（Secret）—— 前端帶這組密語呼叫 Worker；多人模式可以不設
FLOWPLAN_PROXY_SECRET=

# 多人模式（Secret）—— 簽登入 session 用的亂碼；沒設就退回用 FLOWPLAN_PROXY_SECRET
FLOWPLAN_SESSION_SECRET=

# Google 登入（Secret）—— Google Cloud Console 的 OAuth 用戶端
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub 登入（Secret，可選）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 允許登入的 email（逗號分隔）；空的 = 不開放登入
ALLOWED_USERS=

# 允許呼叫的來源（逗號分隔）；登入後也只允許跳回這些網址
ALLOWED_ORIGINS=https://youlun13.github.io

# 模型、單次輸出上限、每人每日次數（輔助保護，不取代 Anthropic workspace spend limit）
AI_MODEL=claude-haiku-5-5
AI_MAX_OUTPUT_TOKENS=1024
AI_DAILY_LIMIT_PER_USER=60

# 跨裝置同步：KV namespace 綁定名稱固定為 FLOWPLAN_KV（在 Worker Settings → Bindings 設定，不是變數）
